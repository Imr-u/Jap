---
const { title = 'JLPT Reader' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #fafaf8;
        --ink: #1c1c1c;
        --muted: #6b6b6b;
        --accent: #b23b3b;
        --card: #ffffff;
        --border: #e5e2dc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.6;
      }
      a { color: inherit; }
      header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      header a { text-decoration: none; font-weight: 700; }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      .crumbs {
        font-size: 0.85rem;
        color: var(--muted);
        margin-bottom: 1rem;
      }
      .crumbs a { text-decoration: none; }
      .crumbs a:hover { text-decoration: underline; }
      .card-list {
        display: grid;
        gap: 0.75rem;
      }
      .card {
        display: block;
        padding: 1rem 1.25rem;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        text-decoration: none;
      }
      .card:hover { border-color: var(--accent); }
      .card h3 { margin: 0 0 0.25rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">JLPT Reader</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
